{
  "name": "stamp-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "demo": "FAKE_OFFICE=1 tsx --env-file-if-exists=.env src/server.ts",
    "check:gis": "tsx src/gis.check.ts",
    "check:turn": "tsx --env-file=.env src/intake/turn.check.ts",
    "check:demo": "tsx --env-file=.env src/demo.check.ts",
    "golden": "tsx --env-file=.env src/intake/golden.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-relay/sdk": "15.0.1",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "openai": "7.47.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
